          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Ficha completa con DUI', () => pm.expect(pm.response.json().dui).to.eql('04567890-3'));"
                ]
              }
            }
          ]
        },
