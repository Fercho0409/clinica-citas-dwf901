{
  "info": {
    "name": "Clinica DWF901 - API Pacientes y Medicos (Fase 3)",
    "description": "Pruebas de los servicios REST de pacientes, medicos y especialidades.\n\nEjecutar en orden con el Collection Runner: las peticiones guardan los id creados en variables.\nRequiere la base cargada con clinicafinal.sql (los pacientes y medicos 1 tienen citas).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/clinica-citas/api"
    },
    {
      "key": "idPaciente",
      "value": ""
    },
    {
      "key": "idMedico",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Pacientes",
      "item": [
        {
          "name": "P01 Listar pacientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pacientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pacientes"
              ]
            },
            "description": "Positivo. Devuelve PacienteResumen: DUI enmascarado y sin datos de contacto."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('El listado no expone datos de contacto ni DUI completo', () => { const p = pm.response.json()[0]; if (!p) return; pm.expect(p).to.not.have.any.keys('dui','telefono','correo','direccion'); pm.expect(p.duiParcial).to.match(/^\\*{5}/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "P02 Buscar pacientes por texto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pacientes?buscar=mart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pacientes"
              ],
              "query": [
                {
                  "key": "buscar",
                  "value": "mart"
                }
              ]
            },
            "description": "Positivo. Coincidencia parcial en nombres, apellidos o DUI."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "P03 Registrar paciente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pacientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pacientes"
              ]
            },
            "description": "Positivo. 201 Created + Location. Guarda el id en la variable idPaciente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Andrea\",\n  \"apellidos\": \"Rivas Molina\",\n  \"dui\": \"04567890-3\",\n  \"fechaNacimiento\": \"14/02/2000\",\n  \"telefono\": \"7890-1234\",\n  \"correo\": \"andrea.rivas@gmail.com\",\n  \"direccion\": \"Colonia Escalón, San Salvador\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('idPaciente', j.idPaciente);",
                  "pm.test('Trae encabezado Location', () => pm.expect(pm.response.headers.get('Location')).to.include('/pacientes/' + j.idPaciente));",
                  "pm.test('Correo normalizado a minusculas', () => pm.expect(j.correo).to.eql('andrea.rivas@gmail.com'));"
                ]
              }
            }
          ]
        },
        {
          "name": "P04 Obtener paciente registrado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pacientes/{{idPaciente}}",
              "host": [
