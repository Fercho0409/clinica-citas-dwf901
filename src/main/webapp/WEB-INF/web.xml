<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Clinica Citas</display-name>

    <!-- ===== FacesServlet: convierte la app en JSF ===== -->
    <servlet>
        <servlet-name>FacesServlet</servlet-name>
        <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>FacesServlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!-- ===== Configuración JSF ===== -->
    <!--
        Fase 4: Production. En Development JSF muestra al usuario el rastro
        completo de las excepciones y mensajes internos. Para depurar en
        local se puede volver a poner Development temporalmente.
    -->
    <context-param>
        <param-name>javax.faces.PROJECT_STAGE</param-name>
        <param-value>Production</param-value>
    </context-param>
    <context-param>
        <param-name>javax.faces.DEFAULT_SUFFIX</param-name>
        <param-value>.xhtml</param-value>
    </context-param>
    <context-param>
        <param-name>javax.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>
    <context-param>
        <param-name>javax.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>

    <context-param>
        <param-name>javax.faces.ENABLE_CDI_RESOLVER_CHAIN</param-name>
        <param-value>false</param-value>
    </context-param>

    <!-- ===== PrimeFaces: sin tema propio, AdminLTE maneja el estilo ===== -->
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>none</param-value>
    </context-param>
    <context-param>
        <param-name>primefaces.FONT_AWESOME</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- ================================================= -->
    <!-- NUEVO: Configuración de Jersey para la API REST   -->
    <!-- ================================================= -->
    <servlet>
        <servlet-name>Jersey REST Service</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <!--
                Se le entrega a Jersey la clase que enumera los recursos,
                en lugar de pedirle que los busque sola dentro de un paquete.
                El escaneo automatico falla con Java 21:
                "Unsupported class file major version 65".
                Al agregar un recurso nuevo hay que anotarlo en ApiApplication.
            -->
            <param-name>javax.ws.rs.Application</param-name>
            <param-value>sv.edu.udb.clinica.api.ApiApplication</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Jersey REST Service</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

    <!--
        ===== Manejo centralizado de errores (Fase 4, tarea 3) =====
        Los errores de los Managed Beans los atiende ManejadorExcepciones
        (registrado en faces-config.xml). Estas entradas cubren lo que pasa
        fuera de JSF: rutas inexistentes, acceso denegado y cualquier
        excepcion que llegue hasta Tomcat. Todas terminan en la misma pagina,
        sin mostrar el rastro de la excepcion.
        Las rutas /api/* no llegan aqui: ManejadorErrores responde en JSON.
    -->
    <error-page>
        <error-code>403</error-code>
        <location>/error.xhtml</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error.xhtml</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.xhtml</location>
    </error-page>
    <error-page>
        <exception-type>javax.faces.application.ViewExpiredException</exception-type>
        <location>/error.xhtml?tipo=sesion</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.xhtml</location>
    </error-page>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>